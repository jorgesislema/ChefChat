# ChefChat Pro - Environment Configuration
# Copy this file to .env and fill in your values

# AI Provider Configuration
# Options: openrouter, azure, ollama, gemini, claude, openai
CHEFCHAT_AI_PROVIDER=openrouter

# OpenRouter API Key (https://openrouter.ai)
CHEFCHAT_OPENROUTER_API_KEY=

# Azure OpenAI Configuration
CHEFCHAT_AZURE_ENDPOINT=
CHEFCHAT_AZURE_API_KEY=
CHEFCHAT_AZURE_DEPLOYMENT=

# Ollama Configuration
CHEFCHAT_OLLAMA_MODEL=llama3.2

# Gemini API Key (https://ai.google.dev)
CHEFCHAT_GEMINI_API_KEY=

# Claude API Key (https://console.anthropic.com)
CHEFCHAT_CLAUDE_API_KEY=

# OpenAI API Key (https://platform.openai.com)
CHEFCHAT_OPENAI_API_KEY=

# SenseNova (OpenAI compatible)
CHEFCHAT_SENSENOVA_API_KEY=
CHEFCHAT_SENSENOVA_BASE_URL=https://token.sensenova.ai/v1
CHEFCHAT_SENSENOVA_MODEL=

# Proveedor propio compatible con OpenAI
CHEFCHAT_CUSTOM_API_KEY=
CHEFCHAT_CUSTOM_BASE_URL=https://100milionseek.top/v1
CHEFCHAT_CUSTOM_MODEL=deepseek-v4.1-flash-free
# Tambien se acepta HMS_API_KEY como clave del proveedor custom

# Database Configuration
CHEFCHAT_DB_PATH=chefchat.db

# Sandbox Path for Office Operations
CHEFCHAT_SANDBOX_PATH=C:\Temp\ChefChat_Sandbox

# DSPy Optimization (true/false)
CHEFCHAT_USE_DSPY=false

# RAG-Only Mode (true/false)
CHEFCHAT_RAG_ONLY=true

# Logging Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
CHEFCHAT_LOG_LEVEL=INFO
